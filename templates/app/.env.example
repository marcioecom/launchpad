# Substitua todos valores antes de usar.

# Postgres
# Gere a senha com: openssl rand -hex 24
# IMPORTANTE: use -hex (não -base64). Base64 gera caracteres /, +, = que quebram URL parsing.
POSTGRES_DB=APP_NAME
POSTGRES_USER=APP_NAME
POSTGRES_PASSWORD=trocar-por-openssl-rand-hex-24

# DATABASE_URL para a app (apontando para o container postgres na rede internal)
# Substitua a senha em AMBOS os lugares (POSTGRES_PASSWORD acima e aqui).
DATABASE_URL=postgres://APP_NAME:trocar-por-openssl-rand-hex-24@postgres:5432/APP_NAME

# App-specific
NODE_ENV=production
PORT=3000
# Adicione segredos da app aqui (API keys, JWT_SECRET, etc)
