# Credencial do dashboard do Traefik (Basic Auth).
# Formato: usuario:hash-bcrypt  (uma linha, pode ter varios separados por virgula)
#
# Gere com:
#   htpasswd -nB admin
# Cole o resultado abaixo SEM dobrar os $ (no .env o valor e literal;
# o $$ so e necessario quando o hash vai direto no docker-compose.yml).
#
# Exemplo:
# TRAEFIK_DASHBOARD_AUTH=admin:$2y$05$abcdefghijklmnopqrstuvwxyz...
TRAEFIK_DASHBOARD_AUTH=
